{
  "$defs": {
    "EdgeKind": {
      "description": "Relationships currently emitted by the deterministic graph analyzers.",
      "enum": [
        "visualforce_controller",
        "visualforce_extension",
        "visualforce_standard_controller",
        "apex_class_reference",
        "apex_page_reference",
        "soql_object",
        "soql_field",
        "lwc_apex_import",
        "lwc_schema_import",
        "permission_class_access",
        "permission_page_access",
        "permission_object_access",
        "permission_field_access",
        "flow_reference",
        "http_listener_config_reference",
        "connector_config_reference",
        "configuration_properties_reference",
        "property_reference",
        "dataweave_variable_reference",
        "dataweave_module_reference",
        "munit_flow_reference",
        "munit_suite_test",
        "maven_plugin",
        "maven_dependency",
        "dynamic_reference"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "GraphEdgeLabel": {
      "additionalProperties": false,
      "description": "One expected resolved edge, expressed in platform-visible names.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EdgeKind"
        },
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "target": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "target"
      ],
      "title": "GraphEdgeLabel",
      "type": "object"
    },
    "GraphMetricCounts": {
      "additionalProperties": false,
      "properties": {
        "discovered": {
          "minimum": 0,
          "title": "Discovered",
          "type": "integer"
        },
        "expected": {
          "minimum": 1,
          "title": "Expected",
          "type": "integer"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall",
          "type": "number"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "expected",
        "discovered",
        "true_positive",
        "false_negative",
        "false_positive",
        "recall",
        "precision"
      ],
      "title": "GraphMetricCounts",
      "type": "object"
    },
    "Platform": {
      "enum": [
        "salesforce",
        "mulesoft"
      ],
      "title": "Platform",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Exact fixture result without overstating its label-review authority.",
  "properties": {
    "claim_scope": {
      "enum": [
        "exploratory_unreviewed",
        "independently_reviewed_fixture"
      ],
      "title": "Claim Scope",
      "type": "string"
    },
    "exit_gate_eligible": {
      "title": "Exit Gate Eligible",
      "type": "boolean"
    },
    "fixture_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Graph Digest",
      "type": "string"
    },
    "graph_kind": {
      "enum": [
        "source",
        "target"
      ],
      "title": "Graph Kind",
      "type": "string"
    },
    "graph_revision": {
      "maxLength": 160,
      "minLength": 7,
      "title": "Graph Revision",
      "type": "string"
    },
    "label_file_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Label File Digest",
      "type": "string"
    },
    "label_review_status": {
      "enum": [
        "unreviewed_initial",
        "initial_label_set",
        "independently_reviewed"
      ],
      "title": "Label Review Status",
      "type": "string"
    },
    "label_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Label Set Digest",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/GraphMetricCounts"
    },
    "missing_edges": {
      "items": {
        "$ref": "#/$defs/GraphEdgeLabel"
      },
      "title": "Missing Edges",
      "type": "array"
    },
    "platform": {
      "$ref": "#/$defs/Platform"
    },
    "report_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unexpected_edges": {
      "items": {
        "$ref": "#/$defs/GraphEdgeLabel"
      },
      "title": "Unexpected Edges",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "fixture_id",
    "platform",
    "graph_kind",
    "graph_digest",
    "graph_revision",
    "label_set_digest",
    "label_file_digest",
    "label_review_status",
    "claim_scope",
    "metrics",
    "missing_edges",
    "unexpected_edges",
    "exit_gate_eligible"
  ],
  "title": "GraphEvaluationReport",
  "type": "object"
}
