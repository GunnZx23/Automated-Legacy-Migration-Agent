{
  "$defs": {
    "KnowledgeProvenance": {
      "additionalProperties": false,
      "description": "Exact reusable scope and source-run binding copied into every lifecycle record.",
      "properties": {
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "source_evidence_package_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Evidence Package Digest",
          "type": "string"
        },
        "source_graph_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Graph Digest",
          "type": "string"
        },
        "source_model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Model Digest",
          "type": "string"
        },
        "source_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Policy Digest",
          "type": "string"
        },
        "source_request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Request Digest",
          "type": "string"
        },
        "source_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Run Id",
          "type": "string"
        },
        "source_session_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Session Digest",
          "type": "string"
        },
        "source_session_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Session Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "source_wiki_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Wiki Digest",
          "type": "string"
        },
        "target_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "version_scope_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Version Scope Digest",
          "type": "string"
        }
      },
      "required": [
        "source_run_id",
        "source_session_id",
        "source_session_digest",
        "source_evidence_package_digest",
        "source_request_digest",
        "source_graph_digest",
        "source_wiki_digest",
        "source_model_digest",
        "source_policy_digest",
        "platform",
        "source_version",
        "target_version",
        "version_scope_digest"
      ],
      "title": "KnowledgeProvenance",
      "type": "object"
    },
    "Platform": {
      "enum": [
        "salesforce",
        "mulesoft"
      ],
      "title": "Platform",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One independent reviewer decision bound to an exact request.",
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "designated_reviewer": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*$",
      "title": "Designated Reviewer",
      "type": "string"
    },
    "facts_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Facts Digest",
      "type": "string"
    },
    "policy_version": {
      "const": "knowledge-store/1.0",
      "default": "knowledge-store/1.0",
      "title": "Policy Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/KnowledgeProvenance"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "request_requested_at": {
      "format": "date-time",
      "title": "Request Requested At",
      "type": "string"
    },
    "requested_action": {
      "const": "promote_cross_run_knowledge",
      "default": "promote_cross_run_knowledge",
      "title": "Requested Action",
      "type": "string"
    },
    "requester": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*$",
      "title": "Requester",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*$",
      "title": "Reviewer",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "promotion_decided",
      "default": "promotion_decided",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "decision",
    "request_id",
    "request_digest",
    "provenance",
    "facts_digest",
    "request_requested_at",
    "decided_at",
    "requester",
    "designated_reviewer",
    "reviewer"
  ],
  "title": "KnowledgePromotionDecision",
  "type": "object"
}
