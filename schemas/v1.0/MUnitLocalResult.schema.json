{
  "$defs": {
    "MUnitExecutionPhase": {
      "enum": [
        "queued",
        "running",
        "completed",
        "not_applicable",
        "unavailable"
      ],
      "title": "MUnitExecutionPhase",
      "type": "string"
    },
    "MUnitNotApplicableReason": {
      "enum": [
        "no_munit_check_planned",
        "platform_slice_deferred"
      ],
      "title": "MUnitNotApplicableReason",
      "type": "string"
    },
    "MUnitUnavailableReason": {
      "enum": [
        "maven_tool_missing",
        "java_runtime_unavailable",
        "mule_runtime_unavailable",
        "dependency_resolution_unavailable",
        "license_unavailable",
        "report_unavailable"
      ],
      "title": "MUnitUnavailableReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Controlled local state used when completed Surefire XML is unavailable.\n\n``COMPLETED`` accepts sanitized aggregate counts.  ``QUEUED`` and\n``RUNNING`` must not claim a process exit or final counts.\n``NOT_APPLICABLE`` requires an explicit planning reason.  ``UNAVAILABLE``\nrequires an environment/tool reason and may record a nonzero process exit\nif the tool started before the boundary failed.",
  "properties": {
    "command_exit_code": {
      "anyOf": [
        {
          "maximum": 255,
          "minimum": -255,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Exit Code"
    },
    "errors": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errors"
    },
    "failures": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failures"
    },
    "not_applicable_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/MUnitNotApplicableReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "phase": {
      "$ref": "#/$defs/MUnitExecutionPhase"
    },
    "skipped": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipped"
    },
    "suites": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suites"
    },
    "tests": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tests"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/MUnitUnavailableReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "phase"
  ],
  "title": "MUnitLocalResult",
  "type": "object"
}
