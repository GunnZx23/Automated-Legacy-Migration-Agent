{
  "$defs": {
    "KnowledgeCitation": {
      "additionalProperties": false,
      "description": "Portable citation to one exact evidence object and optional locator.",
      "properties": {
        "citation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Citation Id",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        }
      },
      "required": [
        "citation_id",
        "evidence_id",
        "evidence_digest"
      ],
      "title": "KnowledgeCitation",
      "type": "object"
    },
    "KnowledgeConsumerScope": {
      "additionalProperties": false,
      "description": "Exact scope of one later run requesting reusable knowledge.",
      "properties": {
        "consumer_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Consumer Run Id",
          "type": "string"
        },
        "consumer_session_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Consumer Session Id",
          "type": "string"
        },
        "graph_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Graph Digest",
          "type": "string"
        },
        "model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Digest",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "source_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "target_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "version_scope_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Version Scope Digest",
          "type": "string"
        },
        "wiki_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Wiki Digest",
          "type": "string"
        }
      },
      "required": [
        "consumer_run_id",
        "consumer_session_id",
        "platform",
        "source_version",
        "target_version",
        "version_scope_digest",
        "graph_digest",
        "wiki_digest",
        "model_digest",
        "policy_digest"
      ],
      "title": "KnowledgeConsumerScope",
      "type": "object"
    },
    "KnowledgeFact": {
      "additionalProperties": false,
      "description": "Concise structured knowledge; raw prose and source code are prohibited.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/KnowledgeCitation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "fact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Fact Id",
          "type": "string"
        },
        "predicate": {
          "enum": [
            "depends_on",
            "incompatible_with",
            "maps_to",
            "preserves",
            "requires",
            "uses",
            "validated_by"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "subject": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "support": {
          "enum": [
            "direct",
            "reviewed_derivation"
          ],
          "title": "Support",
          "type": "string"
        },
        "value": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "subject",
        "predicate",
        "value",
        "support",
        "citations"
      ],
      "title": "KnowledgeFact",
      "type": "object"
    },
    "KnowledgeLookupMatch": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "fact": {
          "$ref": "#/$defs/KnowledgeFact"
        },
        "promoted_at": {
          "format": "date-time",
          "title": "Promoted At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/KnowledgeProvenance"
        },
        "record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_digest",
        "provenance",
        "promoted_at",
        "expires_at",
        "fact"
      ],
      "title": "KnowledgeLookupMatch",
      "type": "object"
    },
    "KnowledgeProvenance": {
      "additionalProperties": false,
      "description": "Exact reusable scope and source-run binding copied into every lifecycle record.",
      "properties": {
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "source_evidence_package_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Evidence Package Digest",
          "type": "string"
        },
        "source_graph_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Graph Digest",
          "type": "string"
        },
        "source_model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Model Digest",
          "type": "string"
        },
        "source_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Policy Digest",
          "type": "string"
        },
        "source_request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Request Digest",
          "type": "string"
        },
        "source_run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Run Id",
          "type": "string"
        },
        "source_session_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Session Digest",
          "type": "string"
        },
        "source_session_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Session Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "source_wiki_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Wiki Digest",
          "type": "string"
        },
        "target_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "version_scope_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Version Scope Digest",
          "type": "string"
        }
      },
      "required": [
        "source_run_id",
        "source_session_id",
        "source_session_digest",
        "source_evidence_package_digest",
        "source_request_digest",
        "source_graph_digest",
        "source_wiki_digest",
        "source_model_digest",
        "source_policy_digest",
        "platform",
        "source_version",
        "target_version",
        "version_scope_digest"
      ],
      "title": "KnowledgeProvenance",
      "type": "object"
    },
    "Platform": {
      "enum": [
        "salesforce",
        "mulesoft"
      ],
      "title": "Platform",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "consumer_scope": {
      "$ref": "#/$defs/KnowledgeConsumerScope"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/KnowledgeLookupMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "policy_version": {
      "const": "knowledge-store/1.0",
      "default": "knowledge-store/1.0",
      "title": "Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "consumer_scope",
    "as_of",
    "matches"
  ],
  "title": "KnowledgeLookupResult",
  "type": "object"
}
