{
  "$defs": {
    "PilotCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "evaluation_mode": {
          "$ref": "#/$defs/PilotEvaluationMode"
        },
        "expected_model_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Expected Model Id",
          "type": "string"
        },
        "expected_provider_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Expected Provider Id",
          "type": "string"
        },
        "fixture_contract_path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Fixture Contract Path",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "source_path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "platform",
        "evaluation_mode",
        "source_path",
        "fixture_contract_path",
        "expected_provider_id",
        "expected_model_id"
      ],
      "title": "PilotCase",
      "type": "object"
    },
    "PilotEvaluationMode": {
      "enum": [
        "agent_run"
      ],
      "title": "PilotEvaluationMode",
      "type": "string"
    },
    "Platform": {
      "enum": [
        "salesforce",
        "mulesoft"
      ],
      "title": "Platform",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/PilotCase"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Cases",
      "type": "array"
    },
    "declaration_status": {
      "const": "predeclared_bounded_pilot",
      "title": "Declaration Status",
      "type": "string"
    },
    "registry_id": {
      "const": "legacy-migration-pilot-v1",
      "title": "Registry Id",
      "type": "string"
    },
    "require_full_completion": {
      "const": false,
      "title": "Require Full Completion",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "registry_id",
    "declaration_status",
    "require_full_completion",
    "cases"
  ],
  "title": "PilotEvaluationRegistry",
  "type": "object"
}
