{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "description": "Immutable evidence for one regular artifact produced by a tool.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "EnvironmentKind": {
      "enum": [
        "local",
        "salesforce_sandbox",
        "mule_runtime",
        "production"
      ],
      "title": "EnvironmentKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactDigest"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "base_revision": {
      "maxLength": 160,
      "minLength": 7,
      "title": "Base Revision",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentKind"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "input_artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Artifact Digest",
      "type": "string"
    },
    "operation": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Operation",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "redacted": {
      "default": false,
      "title": "Redacted",
      "type": "boolean"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "stderr_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stderr Digest"
    },
    "stdout_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stdout Digest"
    },
    "terminal": {
      "title": "Terminal",
      "type": "boolean"
    },
    "tool_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Id",
      "type": "string"
    },
    "working_directory": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Working Directory",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "tool_id",
    "request_id",
    "run_id",
    "attempt",
    "base_revision",
    "environment",
    "input_artifact_digest",
    "operation",
    "working_directory",
    "started_at",
    "ended_at",
    "terminal"
  ],
  "title": "ToolReceipt",
  "type": "object"
}
