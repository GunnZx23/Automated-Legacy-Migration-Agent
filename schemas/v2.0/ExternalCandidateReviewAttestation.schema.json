{
  "additionalProperties": false,
  "description": "One bounded, non-authorizing human review statement for an exact candidate.",
  "properties": {
    "attestation_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Attestation Id",
      "type": "string"
    },
    "authority_granted": {
      "const": false,
      "default": false,
      "title": "Authority Granted",
      "type": "boolean"
    },
    "candidate_reviewed": {
      "title": "Candidate Reviewed",
      "type": "boolean"
    },
    "candidate_zip_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Zip Digest",
      "type": "string"
    },
    "change_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Change Set Digest",
      "type": "string"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "diff_reviewed": {
      "title": "Diff Reviewed",
      "type": "boolean"
    },
    "external_actions_authorized": {
      "default": [],
      "maxItems": 0,
      "minItems": 0,
      "title": "External Actions Authorized",
      "type": "array"
    },
    "final_review_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Final Review Id",
      "type": "string"
    },
    "final_review_request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Final Review Request Digest",
      "type": "string"
    },
    "identity_assurance": {
      "const": "declarative_unverified",
      "default": "declarative_unverified",
      "title": "Identity Assurance",
      "type": "string"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "review_completed_at_raw": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Review Completed At Raw",
      "type": "string"
    },
    "reviewed_at_normalized": {
      "format": "date-time",
      "title": "Reviewed At Normalized",
      "type": "string"
    },
    "reviewer_comment": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reviewer Comment",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*$",
      "title": "Reviewer Id",
      "type": "string"
    },
    "reviewer_relationship_and_expertise": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reviewer Relationship And Expertise",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supplemental_notice": {
      "const": "This external attestation supplements the immutable in-run review click; it does not rewrite that click, authenticate reviewer identity, grant controller authority, or authorize external actions.",
      "default": "This external attestation supplements the immutable in-run review click; it does not rewrite that click, authenticate reviewer identity, grant controller authority, or authorize external actions.",
      "title": "Supplemental Notice",
      "type": "string"
    },
    "test_evidence_reviewed": {
      "title": "Test Evidence Reviewed",
      "type": "boolean"
    },
    "thread_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Thread Id",
      "type": "string"
    },
    "validation_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Validation Report Digest",
      "type": "string"
    }
  },
  "required": [
    "attestation_id",
    "run_id",
    "thread_id",
    "request_id",
    "final_review_id",
    "final_review_request_digest",
    "change_set_digest",
    "validation_report_digest",
    "candidate_zip_digest",
    "reviewer_id",
    "reviewer_relationship_and_expertise",
    "review_completed_at_raw",
    "reviewed_at_normalized",
    "decision",
    "reviewer_comment",
    "candidate_reviewed",
    "diff_reviewed",
    "test_evidence_reviewed"
  ],
  "title": "ExternalCandidateReviewAttestation",
  "type": "object"
}
