<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd">

    <munit:config name="customer-status-api-munit"/>

    <munit:test name="build-customer-status-response-test"
                description="Builds a synthetic ACTIVE customer response">
        <munit:set payload="#[null]">
            <munit:invocation-properties>
                <munit:invocation-property key="customerId"
                                           value="#[&quot;CUST-100&quot;]"
                                           mimeType="text/plain"
                                           encoding="UTF-8"/>
            </munit:invocation-properties>
        </munit:set>
        <flow-ref name="build-customer-status-response"/>
        <munit:assert-on-equals expectedValue="#[&quot;ACTIVE&quot;]"
                                actualValue="#[flowVars.responseStatus]"
                                message="The synthetic status must remain ACTIVE"/>
        <munit:assert-not-null message="The response payload must not be null"/>
    </munit:test>
</mule>
