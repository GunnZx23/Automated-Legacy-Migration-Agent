{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent UI: live Claude (debugger)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "legacy_migration_agent.cli",
      "args": [
        "ui",
        "--project-root",
        ".",
        "--port",
        "8899",
        "--claude-model",
        "claude-sonnet-5",
        "--claude-timeout-seconds",
        "900",
        "--approved-by",
        "local-demo-operator",
        "--approved-remote-provider",
        "bedrock",
        "--allow-live-api",
        "--allow-prompt-data-sharing"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" },
      "serverReadyAction": {
        "pattern": "Agent UI available at (http://127\\.0\\.0\\.1:\\d+/)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser"
      },
      "presentation": {
        "group": "demo",
        "order": 1
      }
    },
    {
      "name": "Agent UI: live Claude",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run --frozen legacy-migration-agent ui --project-root . --port 8899 --claude-model claude-sonnet-5 --claude-timeout-seconds 900 --approved-by local-demo-operator --approved-remote-provider bedrock --allow-live-api --allow-prompt-data-sharing",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Agent UI available at (http://127\\.0\\.0\\.1:\\d+/)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser"
      },
      "presentation": {
        "group": "demo",
        "order": 2
      }
    },
    {
      "name": "Agent UI: recorded double (debugger, offline/free)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/tooling/e2e/record_mode_serve.py",
      "args": ["--port", "8898"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" },
      "serverReadyAction": {
        "pattern": "Agent UI available at (http://127\\.0\\.0\\.1:\\d+/)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser"
      },
      "presentation": {
        "group": "demo",
        "order": 3
      }
    },
    {
      "name": "Agent UI: local Ollama compatibility",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run --frozen legacy-migration-agent ui --project-root . --ollama-model qwen3.8:latest --ollama-timeout-seconds 600",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Agent UI available at (http://127\\.0\\.0\\.1:\\d+/)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser"
      },
      "presentation": {
        "group": "demo",
        "order": 4
      }
    }
  ]
}
